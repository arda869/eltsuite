{
  "rules": {
    "classOwners": {
      "$classId": {
        ".read": false,
        ".write": false
      }
    },
    "classTeachers": {
      "$classId": {
        ".read": false,
        ".write": false
      }
    },
    "sessions": {
      "$classId": {
        ".read": "auth != null",
        "pointer": {
          ".write": "auth != null && (root.child('classOwners').child($classId).val() === auth.uid || root.child('classTeachers').child($classId).child(auth.uid).val() === true)"
        },
        "signals": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || (root.child('classOwners').child($classId).val() === auth.uid || root.child('classTeachers').child($classId).child(auth.uid).val() === true))"
          }
        },
        "board": {
          "$taskId": {
            "pen": {
              ".write": "auth != null && (root.child('classOwners').child($classId).val() === auth.uid || root.child('classTeachers').child($classId).child(auth.uid).val() === true)"
            },
            "strokes": {
              "$sid": {
                ".write": "auth != null && ((root.child('classOwners').child($classId).val() === auth.uid || root.child('classTeachers').child($classId).child(auth.uid).val() === true) || ((root.child('sessions').child($classId).child('board').child($taskId).child('pen').val() === 'all' || root.child('sessions').child($classId).child('board').child($taskId).child('pen').val() === auth.uid) && (!data.exists() || data.child('by').val() === auth.uid) && (!newData.exists() || newData.child('by').val() === auth.uid)) || ($taskId.contains('~') && root.child('sessions').child($classId).child('board').child($taskId).child('pen').val() !== 'locked' && (!data.exists() || data.child('by').val() === auth.uid) && (!newData.exists() || newData.child('by').val() === auth.uid)))"
              },
              ".write": "auth != null && (root.child('classOwners').child($classId).val() === auth.uid || root.child('classTeachers').child($classId).child(auth.uid).val() === true)"
            },
            "cur": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid"
              }
            },
            "showCur": {
              ".write": "auth != null && (root.child('classOwners').child($classId).val() === auth.uid || root.child('classTeachers').child($classId).child(auth.uid).val() === true)"
            }
          }
        },
        "quiz": {
          ".write": "auth != null && (root.child('classOwners').child($classId).val() === auth.uid || root.child('classTeachers').child($classId).child(auth.uid).val() === true)",
          "answers": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          }
        },
        "play": {
          ".write": "auth != null && (root.child('classOwners').child($classId).val() === auth.uid || root.child('classTeachers').child($classId).child(auth.uid).val() === true)"
        }
      }
    },
    "collab": {
      "$doc": {
        ".read": "auth != null && (root.child('collabAccess').child($doc).child('read').child(auth.uid).val() === true || (root.child('collabAccess').child($doc).child('peer').child(auth.uid).val() === true && root.child('collab').child($doc).child('flags').child('shared').val() === true))",
        "u": {
          "$k": {
            ".write": "auth != null && root.child('collabAccess').child($doc).child('edit').child(auth.uid).val() === true && (!newData.exists() || newData.child('by').val() === auth.uid || root.child('collab').child($doc).child('snap').exists())"
          }
        },
        "snap": {
          ".write": "auth != null && root.child('collabAccess').child($doc).child('edit').child(auth.uid).val() === true"
        },
        "aw": {
          "$c": {
            ".write": "auth != null && (root.child('collabAccess').child($doc).child('read').child(auth.uid).val() === true || (root.child('collabAccess').child($doc).child('peer').child(auth.uid).val() === true && root.child('collab').child($doc).child('flags').child('shared').val() === true))"
          }
        },
        "who": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (root.child('collabAccess').child($doc).child('read').child(auth.uid).val() === true || (root.child('collabAccess').child($doc).child('peer').child(auth.uid).val() === true && root.child('collab').child($doc).child('flags').child('shared').val() === true))"
          }
        },
        "init": {
          ".write": "auth != null && !data.exists() && root.child('collabAccess').child($doc).child('edit').child(auth.uid).val() === true"
        },
        "c": {
          "$id": {
            ".write": "auth != null && (root.child('collabAccess').child($doc).child('comment').child(auth.uid).val() === true || (root.child('collabAccess').child($doc).child('peer').child(auth.uid).val() === true && root.child('collab').child($doc).child('flags').child('shared').val() === true))"
          }
        },
        "flags": {
          ".write": "auth != null && root.child('collabAccess').child($doc).child('flags').child(auth.uid).val() === true",
          "shared": {
            ".read": "auth != null && (root.child('collabAccess').child($doc).child('read').child(auth.uid).val() === true || root.child('collabAccess').child($doc).child('peer').child(auth.uid).val() === true)"
          }
        },
        ".write": "auth != null && root.child('collabAccess').child($doc).child('edit').child(auth.uid).val() === true && newData.hasChildren(['snap'])",
        "versions": {
          "$version": {
            ".write": "auth != null && root.child('collabAccess').child($doc).child('edit').child(auth.uid).val() === true && !data.exists() && newData.child('by').val() === auth.uid",
            ".validate": "newData.hasChildren(['name', 'by', 'author', 'at', 'content', 'layout']) && newData.child('content').isString() && newData.child('content').val().length <= 500000 && newData.child('layout').isString() && newData.child('name').isString() && newData.child('name').val().length <= 100"
          }
        }
      }
    },
    "collabAccess": {
      "$doc": {
        ".read": false,
        ".write": false
      }
    },
    "collabAccessIndex": {
      "$doc": {
        ".read": false,
        ".write": false
      }
    },
    "collabLocks": {
      "$classId": {
        ".read": "auth != null",
        "$doc": {
          ".write": "auth != null && (root.child('classOwners').child($classId).val() === auth.uid || root.child('classTeachers').child($classId).child(auth.uid).val() === true)"
        }
      }
    },
    "typing": {
      "$chat": {
        ".read": "auth != null",
        "$key": {
          ".write": "auth != null && (!newData.exists() || newData.isNumber())"
        }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "quizLive": {
      "$runId": {
        ".read": true,
        ".write": false
      }
    }
  }
}
