rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function learnerAccount() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.matches('.*@learners[.]lesson-lit[.]firebaseapp[.]com$');
    }
    function isTeacher() {
      return signedIn() && !learnerAccount()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    function classData(classId) { return get(/databases/$(database)/documents/classes/$(classId)).data; }
    function teachesClass(classId) { return signedIn() && classData(classId).teacherId == request.auth.uid; }
    function memberOf(classId) {
      return signedIn() && exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid));
    }

    // Profiles: teachers create their own; teachers create learner profiles for their class
    match /users/{uid} {
      allow read: if isSelf(uid)
        || (signedIn() && resource.data.role == 'learner' && teachesClass(resource.data.classId));
      allow create: if (isSelf(uid) && !learnerAccount() && request.resource.data.role == 'teacher')
        || (request.resource.data.role == 'learner' && isTeacher() && teachesClass(request.resource.data.classId));
      allow update: if isSelf(uid) && request.resource.data.role == resource.data.role
        && request.resource.data.get('classId', null) == resource.data.get('classId', null);
      allow delete: if signedIn() && resource.data.role == 'learner' && teachesClass(resource.data.classId);
    }

    match /classes/{classId} {
      allow read: if signedIn() && (resource.data.teacherId == request.auth.uid || memberOf(classId));
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      allow update: if signedIn()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.classCode == resource.data.classCode;
      allow delete: if signedIn() && resource.data.teacherId == request.auth.uid;

      // Content learners can see
      match /topics/{topicId} {
        allow read: if teachesClass(classId) || memberOf(classId);
        allow write: if teachesClass(classId);
      }
      match /items/{itemId} {
        allow read: if teachesClass(classId) || memberOf(classId);
        allow write: if teachesClass(classId);

        match /tasks/{taskId} {
          allow read: if teachesClass(classId) || memberOf(classId);
          allow write: if teachesClass(classId);

          // Earlier versions of the task (with answers): teacher only
          match /versions/{versionId} {
            allow read, write: if teachesClass(classId);
          }

          // Answer key: learners can read it only after they have checked their answers
          match /private/{docId} {
            allow read: if teachesClass(classId)
              || (docId == 'key' && memberOf(classId)
                  && (get(/databases/$(database)/documents/classes/$(classId)/answers/$(taskId + '_' + request.auth.uid)).data.checked == true
                      || get(/databases/$(database)/documents/classes/$(classId)/live/state).data.get('revealed', {}).get(taskId, 0) != 0
                      || get(/databases/$(database)/documents/classes/$(classId)/live/state).data.get('revealedQs', {}).get(taskId, []).size() > 0));
            allow write: if teachesClass(classId);
          }
        }
      }

      // Learner answers: one document per task per learner
      match /answers/{answerId} {
        allow read: if teachesClass(classId)
          || (signedIn() && answerId.split('_')[1] == request.auth.uid);
        allow create: if memberOf(classId)
          && request.resource.data.learnerUid == request.auth.uid
          && answerId == request.resource.data.taskId + '_' + request.auth.uid
          && !('marks' in request.resource.data);
        allow update: if memberOf(classId)
          && request.resource.data.learnerUid == request.auth.uid
          && answerId == request.resource.data.taskId + '_' + request.auth.uid
          && request.resource.data.get('marks', {}) == resource.data.get('marks', {});
        // The teacher only adds marks and comments.
        allow update: if teachesClass(classId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['marks']);
        allow delete: if teachesClass(classId);
      }

      // Peer feedback sent to a classmate: the giver writes it, the receiver and the teacher read it
      match /feedback/{fid} {
        allow read: if teachesClass(classId)
          || (memberOf(classId) && (resource.data.fromUid == request.auth.uid
              || resource.data.to == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.learnerId));
        allow create, update: if memberOf(classId) && request.resource.data.fromUid == request.auth.uid;
        allow delete: if teachesClass(classId);
      }

      // Short audio clips (recorded or uploaded by the teacher)
      match /media/{mediaId} {
        allow read: if teachesClass(classId) || memberOf(classId);
        allow create: if teachesClass(classId) && request.resource.data.size < 700000;
        allow delete: if teachesClass(classId);
      }

      // Profile pictures in use in this class (one person per picture)
      match /avatars/{key} {
        allow read: if teachesClass(classId) || memberOf(classId);
        allow create: if (teachesClass(classId) || memberOf(classId)) && request.resource.data.uid == request.auth.uid;
        allow update: if resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
        allow delete: if resource.data.uid == request.auth.uid || teachesClass(classId);
      }

      // Tag notifications
      match /notices/{nid} {
        allow read: if teachesClass(classId)
          || (memberOf(classId) && resource.data.to == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.learnerId);
        allow create: if (teachesClass(classId) || memberOf(classId)) && request.resource.data.fromUid == request.auth.uid;
        allow delete: if teachesClass(classId);
      }

      // Message boards and post-it walls
      match /boards/{boardId}/posts/{postId} {
        allow read: if teachesClass(classId) || memberOf(classId);
        allow create: if (teachesClass(classId) || memberOf(classId))
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
        allow update: if (teachesClass(classId) || memberOf(classId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if teachesClass(classId) || resource.data.byUid == request.auth.uid;
      }

      // Shared "draw a card" piles (played together as a class)
      match /picks/{pickId} {
        allow read: if teachesClass(classId) || memberOf(classId);
        allow write: if teachesClass(classId)
          || (memberOf(classId) && request.resource.data.keys().hasOnly(['taskId', 'pickId', 'h', 'b', 'seq', 'by', 'at']));
      }

      // Where the teacher is in a lesson
      match /live/{docId} {
        allow read: if teachesClass(classId) || memberOf(classId);
        allow write: if teachesClass(classId);
      }

      // Who is online and which task they are on
      match /presence/{uid} {
        allow read: if teachesClass(classId);
        allow write: if isSelf(uid) && memberOf(classId);
        allow delete: if teachesClass(classId);
      }

      // Roster: teacher only
      match /learners/{learnerId} {
        allow read, write: if teachesClass(classId);
      }
      match /secrets/{learnerId} {
        allow read, write: if teachesClass(classId);
      }
      match /members/{memberUid} {
        allow read: if teachesClass(classId) || isSelf(memberUid);
        allow write: if teachesClass(classId);
      }
    }

    // Class codes: looked up one at a time when learners join
    match /classCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.teacherId == request.auth.uid;
    }
  }
}
