rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function learnerAccount() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.matches('.*@learners[.]lesson-lit[.]firebaseapp[.]com$');
    }
    // A teacher's account as the owner of ELT Suite keeps it: paused, or over its space (see
    // scripts/space.mjs, which measures every teacher's files a few times an hour).
    function acct(uid) { return exists(/databases/$(database)/documents/accounts/$(uid)) ? get(/databases/$(database)/documents/accounts/$(uid)).data : {}; }
    function active() { return signedIn() && acct(request.auth.uid).get('suspended', false) != true; }
    function hasRoom(uid) { return acct(uid).get('over', false) != true; }
    function isTeacher() {
      return active() && !learnerAccount()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    function classData(classId) { return get(/databases/$(database)/documents/classes/$(classId)).data; }
    function coRole(c) { return c.get('coTeachers', {}).get(request.auth.uid, {}).get('role', ''); }
    function teachesClass(classId) { return active() && (classData(classId).teacherId == request.auth.uid || coRole(classData(classId)) == 'co'); }
    function viewsClass(classId) { return active() && (classData(classId).teacherId == request.auth.uid || coRole(classData(classId)) in ['co', 'viewer']); }
    // An admin of the organisation a class belongs to: manages its learners, not its lessons.
    function runsClass(classId) { return signedIn() && classData(classId).get('org', null) is string && adminOfOrg(classData(classId).org); }
    function ownsClass(classId) { return signedIn() && classData(classId).teacherId == request.auth.uid; }
    function myEmailKey() { return request.auth.token.get('email', '').lower().replace('[.]', ','); }
    // A colleague a lesson is shared with: they edit that lesson only.
    function editsItem(classId, itemId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)/items/$(itemId)).data.get('editors', {});
    }
    // A super admin: runs accounts, organisations, switches and support (see lib/admin.ts). The
    // app's owner always is one; other super admins are in superAdmins/{email}, by a verified email.
    function isOwner() {
      return signedIn() && (request.auth.token.get('email', '').lower() == 'ardanurioglu@gmail.com'
        || (request.auth.token.get('email_verified', false) == true && request.auth.token.get('email', '') != ''
            && exists(/databases/$(database)/documents/superAdmins/$(request.auth.token.email.lower()))));
    }
    // An organisation's admin, making a class for one of its teachers.
    function orgAdminFor(orgId, teacher) {
      return signedIn() && orgId is string
        && request.auth.token.get('email', '').lower() in get(/databases/$(database)/documents/orgs/$(orgId)).data.adminEmails
        && teacher in get(/databases/$(database)/documents/orgs/$(orgId)).data.teachers;
    }
    // Creating a new training course (or converting a language class) requires a grant.
    // Removing the grant does not strand existing courses or their participants.
    function canStartTraining(c) {
      let a = acct(c.teacherId);
      let org = c.get('org', null);
      return c.get('kind', 'language') != 'training'
        || (org == null && a.get('org', null) == null && a.get('teacherTrainer', false) == true)
        || (org is string && a.get('org', null) == org
          && get(/databases/$(database)/documents/orgs/$(org)).data.get('allow', {}).get('trainers', false) == true
          && (orgAdminFor(org, c.teacherId)
            || get(/databases/$(database)/documents/orgs/$(org)).data.get('teachers', {}).get(c.teacherId, {}).get('trainer', false) == true));
    }
    function memberOf(classId) {
      return signedIn() && exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid));
    }

    // Coaching stays private from admins and view-as sessions.
    match /teachingCoach/{uid}/{kind}/{id} {
      function ownCoach() { return isSelf(uid) && isTeacher() && request.auth.token.get('proxyBy', null) == null; }
      allow read, delete: if ownCoach() && kind in ['settings', 'reflections', 'inquiries'];
      function validContext() { return kind != 'settings' || id != 'context' || (request.resource.data.keys().hasOnly(['profile','beliefs','reflections','inquiries','mode','version']) && request.resource.data.profile is bool && request.resource.data.beliefs is bool && request.resource.data.reflections is bool && request.resource.data.inquiries is bool && request.resource.data.get('mode','Reflect with me') in ['Reflect with me','Challenge my thinking','Help me experiment','Teacher trainer mode']); }
      allow create: if ownCoach() && kind in ['settings', 'reflections', 'inquiries']
        && (kind != 'settings' || id in ['profile', 'context'])
        && validContext() && request.resource.data.size() < 30 && request.resource.data.version == 1;
      allow update: if ownCoach() && kind in ['settings', 'reflections', 'inquiries']
        && (kind != 'settings' || id in ['profile', 'context'])
        && validContext() && request.resource.data.size() < 30 && request.resource.data.version is int
        && request.resource.data.version == resource.data.version + 1;
    }

    // Profiles: teachers create their own; teachers create learner profiles for their class
    match /users/{uid} {
      allow read: if isSelf(uid) || isOwner()
        || (signedIn() && resource.data.role == 'learner' && teachesClass(resource.data.classId));
      // Teachers join by invitation for now: an invitation code (used up by one in the same write),
      // an organisation's invitation (its id comes with the profile), or they run ELT Suite.
      allow create: if (isSelf(uid) && !learnerAccount() && request.resource.data.role == 'teacher'
          && (codeUsedNow(request.resource.data.get('code', null)) || invitedHere(request.resource.data.get('invite', null)) || isOwner()))
        || (request.resource.data.role == 'learner' && isTeacher() && (teachesClass(request.resource.data.classId) || runsClass(request.resource.data.classId))
            && countedIn(classData(request.resource.data.classId).get('org', null), 'learners'));
      allow update: if isSelf(uid) && request.resource.data.role == resource.data.role
        && request.resource.data.get('classId', null) == resource.data.get('classId', null);
      allow delete: if signedIn() && resource.data.role == 'learner' && (teachesClass(resource.data.classId) || runsClass(resource.data.classId));

      // Editable video projects are private. Shared outputs live in videoAssets.
      match /videoProjects/{projectId} {
        allow read, delete: if isSelf(uid) && isTeacher();
        allow create, update: if isSelf(uid) && isTeacher() && (resource != null || hasRoom(uid))
          && request.resource.data.keys().hasOnly(['project', 'updatedAt'])
          && request.resource.data.project is map && request.resource.data.project.version == 1
          && request.resource.data.project.tracks is list && request.resource.data.project.tracks.size() <= 30;
      }
      // A teacher's personal question bank
      match /bank/{bankId} {
        allow read, write: if isSelf(uid) && !learnerAccount();
      }
      // Colleagues: two teachers connected through an invitation link. The invited teacher adds
      // themselves to the inviter's list, which the rules allow only with the inviter's link.
      match /colleagues/{other} {
        allow read: if isSelf(uid);
        allow create, update: if (isSelf(uid) && isTeacher())
          || (signedIn() && request.auth.uid == other && isTeacher()
              && get(/databases/$(database)/documents/colleagueLinks/$(request.resource.data.via)).data.from == uid);
        allow delete: if isSelf(uid) || (signedIn() && request.auth.uid == other);
      }
      // Things shared with this teacher through a link, kept so they can find them again
      match /received/{shareId} {
        allow read, write: if isSelf(uid) && !learnerAccount();
      }
      // A teacher's media archive and its folders
      match /archive/{itemId} {
        allow read: if isSelf(uid) && !learnerAccount();
        allow update: if isSelf(uid) && !learnerAccount() && !('purgeRequestedAt' in resource.data) && !('purgingAt' in resource.data)
          && !('purgingAt' in request.resource.data)
          && (!('purgeRequestedAt' in request.resource.data) || resource.data.get('deletedAt', 0) > 0);
        allow delete: if isSelf(uid) && !learnerAccount();
        allow create: if isSelf(uid) && !learnerAccount() && active() && hasRoom(uid);
      }
      match /archiveFolders/{folderId} {
        allow read, write: if isSelf(uid) && !learnerAccount();
      }
      // Tasks kept in the resources library
      match /libTasks/{taskId} {
        allow read, write: if isSelf(uid) && !learnerAccount();
      }
      // Where tasks sit in the resources library's folders
      match /libPlaces/{placeId} {
        allow read, write: if isSelf(uid) && !learnerAccount();
      }
      // Media added straight to the archive (copied into a class when it is first used there)
      match /media/{mediaId} {
        allow read, delete: if isSelf(uid) && !learnerAccount();
        allow create, update: if isSelf(uid) && !learnerAccount() && active() && (resource != null || hasRoom(uid))
          && (!('data' in request.resource.data) || request.resource.data.data.size() < 1000000)
          && request.resource.data.get('size', 0) < 700000;
      }
    }

    // Video originals, references and generated media. No anonymous or learner access.
    function videoReadable(a) {
      return isTeacher() && (a.owner == request.auth.uid || request.auth.uid in a.readers
        || (a.org != '' && exists(/databases/$(database)/documents/orgs/$(a.org))
          && request.auth.uid in get(/databases/$(database)/documents/orgs/$(a.org)).data.get('teachers', {})));
    }
    match /videoAssets/{assetId} {
      allow read: if videoReadable(resource.data);
      allow create: if isTeacher() && hasRoom(request.auth.uid)
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.org == '' && request.resource.data.readers == []
        && request.resource.data.kind in ['video', 'audio', 'image', 'character']
        && request.resource.data.ready == false
        && request.resource.data.parts is int && request.resource.data.parts > 0 && request.resource.data.parts <= 228
        && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 104857600
        && (request.resource.data.parts - 1) * 460800 < request.resource.data.size
        && request.resource.data.size <= request.resource.data.parts * 460800;
      // Sharing is validated by the server against actual organisation/colleague membership.
      allow update: if isTeacher() && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'voice', 'ready']);
      allow delete: if isTeacher() && resource.data.owner == request.auth.uid;
      match /parts/{partId} {
        function validPart() {
          let a = get(/databases/$(database)/documents/videoAssets/$(assetId)).data;
          let d = request.resource.data;
          return partId.matches('^(0|[1-9][0-9]{0,2})$') && int(partId) < a.parts
            && d.keys().hasOnly(['data', 'size']) && d.size is int
            && d.size == (int(partId) == a.parts - 1 ? a.size - int(partId) * 460800 : 460800)
            && d.data is string && d.data.matches('^[A-Za-z0-9+/]+={0,2}$')
            && d.data.size() % 4 == 0 && d.data.size() >= d.size * 4 / 3
            && d.data.size() < d.size * 4 / 3 + 4
            && (d.size % 3 == 0 ? d.data.matches('^[^=]+$') : d.size % 3 == 1 ? d.data.matches('^.*==$') : d.data.matches('^.*[^=]=$'));
        }
        allow read: if videoReadable(get(/databases/$(database)/documents/videoAssets/$(assetId)).data);
        allow create: if isTeacher() && hasRoom(request.auth.uid)
          && get(/databases/$(database)/documents/videoAssets/$(assetId)).data.owner == request.auth.uid
          && get(/databases/$(database)/documents/videoAssets/$(assetId)).data.ready == false
          && validPart();
        allow delete: if isTeacher() && get(/databases/$(database)/documents/videoAssets/$(assetId)).data.owner == request.auth.uid;
      }
    }

    // Private, opt-in discovery summaries. Never readable by organisations or super admins.
    match /featureDiscovery/{uid} {
      function mine() { return isSelf(uid) && isTeacher() && request.auth.token.get('proxyBy', null) == null; }
      function featureKeys(m) { return m.keys().hasOnly(['lessons', 'notes', 'assessment', 'live', 'timetable', 'collab', 'reading']); }
      function usageOK(m, k) {
        return !(k in m) || (m[k] is map && m[k].keys().hasAll(['count', 'lastUsed', 'events', 'guided'])
          && m[k].keys().hasOnly(['count', 'lastUsed', 'events', 'guided'])
          && m[k].count is int && m[k].count >= 1 && m[k].count <= 10000
          && m[k].lastUsed is int && m[k].lastUsed >= 0
          && m[k].events is list && m[k].events.size() <= 80 && m[k].guided is bool);
      }
      function feedbackOK(m, k) {
        return !(k in m) || (m[k] is map && m[k].keys().hasOnly(['dismissed', 'snoozedUntil', 'offeredAt', 'guideStarted', 'openedAt'])
          && m[k].get('dismissed', false) is bool && m[k].get('guideStarted', false) is bool
          && m[k].get('snoozedUntil', 0) is int && m[k].get('offeredAt', 0) is int && m[k].get('openedAt', 0) is int);
      }
      function validDiscovery() {
        let d = request.resource.data;
        let s = d.settings;
        return d.keys().hasAll(['settings', 'usage', 'feedback', 'delivery']) && d.keys().hasOnly(['settings', 'usage', 'feedback', 'delivery'])
          && s.keys().hasAll(['tracking', 'enabled', 'gapDays', 'quietStart', 'quietEnd', 'pausedUntil'])
          && s.keys().hasOnly(['tracking', 'enabled', 'gapDays', 'quietStart', 'quietEnd', 'pausedUntil'])
          && s.tracking is bool && s.enabled is bool && (!s.enabled || s.tracking)
          && s.gapDays in [1, 3, 7] && s.quietStart is int && s.quietStart >= 0 && s.quietStart <= 23
          && s.quietEnd is int && s.quietEnd >= 0 && s.quietEnd <= 23 && s.pausedUntil is int && s.pausedUntil >= 0
          && d.usage is map && featureKeys(d.usage) && d.feedback is map && featureKeys(d.feedback)
          && usageOK(d.usage, 'lessons') && usageOK(d.usage, 'notes') && usageOK(d.usage, 'assessment') && usageOK(d.usage, 'live')
          && usageOK(d.usage, 'timetable') && usageOK(d.usage, 'collab') && usageOK(d.usage, 'reading')
          && feedbackOK(d.feedback, 'lessons') && feedbackOK(d.feedback, 'notes') && feedbackOK(d.feedback, 'assessment') && feedbackOK(d.feedback, 'live')
          && feedbackOK(d.feedback, 'timetable') && feedbackOK(d.feedback, 'collab') && feedbackOK(d.feedback, 'reading')
          && d.delivery.keys().hasAll(['feature', 'at', 'read']) && d.delivery.keys().hasOnly(['feature', 'at', 'read'])
          && d.delivery.feature in ['', 'lessons', 'notes', 'assessment', 'live', 'timetable', 'collab', 'reading']
          && d.delivery.at is int && d.delivery.at >= 0 && d.delivery.read is bool;
      }
      allow read, delete: if mine();
      allow create, update: if mine() && validDiscovery();
    }

    match /classes/{classId} {
      allow read: if isOwner() || (signedIn() && resource.data.get('org', null) is string && adminOfOrg(resource.data.org)) || signedIn() && (resource.data.teacherId == request.auth.uid || memberOf(classId)
        || request.auth.uid in resource.data.get('coTeachers', {})
        || request.auth.uid in resource.data.get('teacherIds', [])
        || request.auth.uid in resource.data.get('lessonEditorIds', [])
        || request.auth.token.get('email', '').lower() in resource.data.get('inviteEmails', []));
      allow create: if ((isTeacher() && request.resource.data.teacherId == request.auth.uid) || orgAdminFor(request.resource.data.get('org', null), request.resource.data.teacherId))
        && canStartTraining(request.resource.data)
        && request.resource.data.get('lessonStyle', 'adult') in ['adult', 'young']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        // within the organisation's limit of classes, counted in the same write
        && countedIn(request.resource.data.get('org', null), 'classes');
      allow update: if signedIn()
        && (resource.data.get('kind', 'language') == 'training' || canStartTraining(request.resource.data))
        && request.resource.data.get('lessonStyle', 'adult') in ['adult', 'young']
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.classCode == resource.data.classCode
        && (
          resource.data.teacherId == request.auth.uid
          // an organisation admin adding or removing learners: only the count changes
          || (resource.data.get('org', null) is string && adminOfOrg(resource.data.org) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['learnerCount']))
          // a co-teacher may change anything except who has access
          || (coRole(resource.data) == 'co' && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coTeachers', 'teacherIds', 'invites', 'inviteEmails']))
          // an invited teacher accepts (or declines) their own invitation
          || (myEmailKey() in resource.data.get('invites', {})
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coTeachers', 'teacherIds', 'invites', 'inviteEmails'])
            && !(myEmailKey() in request.resource.data.get('invites', {}))
            && (!(request.auth.uid in request.resource.data.get('coTeachers', {}))
              || request.resource.data.coTeachers[request.auth.uid].role == resource.data.invites[myEmailKey()].role))
        );
      allow delete: if signedIn() && resource.data.teacherId == request.auth.uid;

      // Speaking attempts are visible only to their learner and class teachers.
      // All writes go through authenticated server functions, including feedback.
      match /speakingActivities/{activityId} {
        allow read: if viewsClass(classId) || memberOf(classId);
        allow write: if false;
        match /sessions/{sessionId} {
          allow read: if teachesClass(classId) || (memberOf(classId) && resource.data.uid == request.auth.uid);
          allow write: if false;
        }
      }

      // Content learners can see
      match /topics/{topicId} {
        allow read: if viewsClass(classId) || memberOf(classId);
        allow write: if teachesClass(classId);
      }
      match /items/{itemId} {
        allow read: if viewsClass(classId) || memberOf(classId) || (signedIn() && request.auth.uid in resource.data.get('editors', {}));
        allow write: if teachesClass(classId) || (editsItem(classId, itemId) && request.resource.data.get('editors', {}) == resource.data.get('editors', {}));

        match /tasks/{taskId} {
          allow read: if viewsClass(classId) || memberOf(classId) || editsItem(classId, itemId);
          allow write: if teachesClass(classId) || editsItem(classId, itemId);

          // Earlier versions of the task (with answers): teacher only
          match /versions/{versionId} {
            allow read: if viewsClass(classId) || editsItem(classId, itemId);
            allow write: if teachesClass(classId) || editsItem(classId, itemId);
          }

          // Answer key: learners can read it only after they have checked their answers.
          // Body: the content of a task only some learners may open (groups and versions).
          match /private/{docId} {
            allow read: if viewsClass(classId) || editsItem(classId, itemId)
              || (docId == 'body' && memberOf(classId)
                  && get(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)).data.learnerId
                     in get(/databases/$(database)/documents/classes/$(classId)/items/$(itemId)/tasks/$(taskId)).data.get('allowed', []))
              || (docId == 'key' && memberOf(classId)
                  && (get(/databases/$(database)/documents/classes/$(classId)/items/$(itemId)/tasks/$(taskId)).data.get('restricted', false) == false
                      || get(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)).data.learnerId
                         in get(/databases/$(database)/documents/classes/$(classId)/items/$(itemId)/tasks/$(taskId)).data.get('allowed', []))
                  && ((get(/databases/$(database)/documents/classes/$(classId)/answers/$(taskId + '_' + request.auth.uid)).data.checked == true
                       && get(/databases/$(database)/documents/classes/$(classId)/items/$(itemId)/tasks/$(taskId)).data.get('exam', null) == null
                       && get(/databases/$(database)/documents/classes/$(classId)/items/$(itemId)).data.get('type', 'lesson') != 'exam')
                      || get(/databases/$(database)/documents/classes/$(classId)/items/$(itemId)/tasks/$(taskId)).data.get('examReleased', false) == true
                      || (get(/databases/$(database)/documents/classes/$(classId)/items/$(itemId)).data.get('type', 'lesson') == 'exam'
                          && get(/databases/$(database)/documents/classes/$(classId)/items/$(itemId)).data.get('examReleased', false) == true)
                      || get(/databases/$(database)/documents/classes/$(classId)/live/state).data.get('revealed', {}).get(taskId, 0) != 0
                      || get(/databases/$(database)/documents/classes/$(classId)/live/state).data.get('revealedQs', {}).get(taskId, []).size() > 0));
            allow write: if teachesClass(classId) || editsItem(classId, itemId);
          }
        }
      }

      // Evidence and coaching reports are server-written and teacher-only.
      match /learningEvidence/{id} { allow read: if teachesClass(classId); }
      match /learningReports/{id} { allow read: if teachesClass(classId); }

      // Learner answers: one document per task per learner
      match /answers/{answerId} {
        allow read: if viewsClass(classId)
          || (signedIn() && answerId.split('_')[1] == request.auth.uid);
        allow create: if memberOf(classId)
          && request.resource.data.learnerUid == request.auth.uid
          && answerId == request.resource.data.taskId + '_' + request.auth.uid
          && !('marks' in request.resource.data);
        allow update: if memberOf(classId)
          && request.resource.data.learnerUid == request.auth.uid
          && answerId == request.resource.data.taskId + '_' + request.auth.uid
          && request.resource.data.get('marks', {}) == resource.data.get('marks', {});
        // The teacher only adds marks and comments.
        allow update: if teachesClass(classId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['marks', 'corrections']);
        allow delete: if teachesClass(classId);
      }

      // Group sets (breakout rooms): the teacher makes them; learners can see their room
      match /groupSets/{sid} {
        allow read: if viewsClass(classId) || memberOf(classId);
        allow write: if teachesClass(classId);
      }

      // Survey and poll answers. Anonymous answers carry no uid, learner id or name and have a
      // random id; named answers use surveyId_uid so the learner can change them.
      match /surveyResponses/{rid} {
        allow read: if viewsClass(classId) || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
        allow create: if memberOf(classId) && (
          (!('uid' in request.resource.data) && !('learnerId' in request.resource.data) && !('name' in request.resource.data))
          || (request.resource.data.uid == request.auth.uid && rid == request.resource.data.surveyId + '_' + request.auth.uid));
        allow update: if memberOf(classId) && resource.data.get('uid', '') == request.auth.uid && request.resource.data.uid == request.auth.uid;
        allow delete: if teachesClass(classId);
      }
      match /surveyDone/{did} {
        allow read: if viewsClass(classId) || (signedIn() && resource.data.uid == request.auth.uid);
        allow create, update: if memberOf(classId) && request.resource.data.uid == request.auth.uid && did == request.resource.data.surveyId + '_' + request.auth.uid;
        allow delete: if teachesClass(classId);
      }
      // Shared results: counts and texts only
      match /surveyResults/{sid} {
        allow read: if viewsClass(classId) || memberOf(classId);
        allow write: if teachesClass(classId);
      }

      // Class notebook. Who may write is set on the class (notebook.level: view | add | all,
      // notebook.review, notebook.blocked); the rules check it, not just the app.
      function nb() { return classData(classId).get('notebook', {}); }
      function nbLevel() { return nb().get('level', 'view'); }
      function nbReview() { return nb().get('review', false) == true; }
      function myLearnerId() { return get(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)).data.learnerId; }
      function nbCanAdd() { return memberOf(classId) && nbLevel() != 'view' && !(myLearnerId() in nb().get('blocked', [])); }
      match /notebook/{eid} {
        // Learners see published, unhidden entries and anything they added themselves.
        allow read: if viewsClass(classId)
          || (memberOf(classId) && ((resource.data.status == 'published' && resource.data.get('hidden', false) == false) || resource.data.addedBy == request.auth.uid));
        allow create: if teachesClass(classId)
          || (nbCanAdd() && request.resource.data.type != 'page'
              && request.resource.data.addedBy == request.auth.uid
              && request.resource.data.status == (nbReview() ? 'pending' : 'published')
              && request.resource.data.get('hidden', false) == false);
        // Learners change `data` only (or propose a change under review); never pages, status or hidden.
        allow update: if teachesClass(classId)
          || (nbCanAdd() && resource.data.type != 'page'
              && (nbLevel() == 'all' || resource.data.addedBy == request.auth.uid)
              && (nbReview()
                  ? (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pending']) && request.resource.data.pending.by == request.auth.uid)
                  : (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'editedBy', 'editedByName', 'updatedAt']) && request.resource.data.editedBy == request.auth.uid)));
        allow delete: if teachesClass(classId);

        // Earlier versions: anyone who edits writes one; only the teacher reads and restores
        match /history/{hid} {
          allow read: if viewsClass(classId);
          allow create: if teachesClass(classId) || (nbCanAdd() && request.resource.data.by is string);
          allow delete: if teachesClass(classId);
        }
      }
      // A learner's private notebook: only they can read or write it
      match /myNotes/{nid} {
        allow read: if signedIn() && resource.data.uid == request.auth.uid;
        allow create: if memberOf(classId) && request.resource.data.uid == request.auth.uid;
        allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }

      // Attendance: learners add their own minutes while a lesson is live; the teacher corrects
      // The class's video host key: only its teachers read it; the scheduled script writes it.
      match /video/{k} {
        allow read: if viewsClass(classId);
      }
      // Each learner's portfolio: the teachers keep it; the learner reads their own.
      match /portfolio/{pid} {
        allow read: if viewsClass(classId) || (signedIn() && resource.data.get('learnerUid', '') == request.auth.uid);
        allow write: if teachesClass(classId);
      }
      match /attendance/{aid} {
        allow read: if viewsClass(classId) || (signedIn() && resource.data.uid == request.auth.uid);
        allow create: if teachesClass(classId)
          || (memberOf(classId) && request.resource.data.uid == request.auth.uid && aid == request.resource.data.itemId + '_' + request.auth.uid && !('corrected' in request.resource.data));
        allow update: if teachesClass(classId)
          || (memberOf(classId) && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid
              && request.resource.data.get('corrected', null) == resource.data.get('corrected', null));
        allow delete: if teachesClass(classId);
      }
      // Mistake bank: each learner's own review deck; the teacher reads all of it
      match /mistakes/{mid} {
        allow read: if viewsClass(classId) || (signedIn() && resource.data.learnerUid == request.auth.uid);
        allow create, update: if memberOf(classId) && request.resource.data.learnerUid == request.auth.uid;
        allow delete: if teachesClass(classId) || (signedIn() && resource.data.learnerUid == request.auth.uid);
      }

      // Exam attempts: a learner starts once and can only add the time they submitted
      match /examRuns/{rid} {
        allow read: if viewsClass(classId) || (signedIn() && resource.data.uid == request.auth.uid);
        allow create: if memberOf(classId) && request.resource.data.uid == request.auth.uid
          && rid == request.resource.data.scope + '_' + request.auth.uid
          && request.resource.data.submittedMs == null;
        allow update: if signedIn() && resource.data.uid == request.auth.uid && resource.data.submittedMs == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submittedMs']);
        allow delete: if teachesClass(classId);
      }

      // The level a learner chose for a task with level versions
      match /levelChoices/{cid} {
        allow read: if viewsClass(classId) || (signedIn() && resource.data.uid == request.auth.uid);
        allow create, update: if memberOf(classId) && request.resource.data.uid == request.auth.uid
          && cid == request.resource.data.family + '_' + request.auth.uid
          && request.resource.data.learnerId == get(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)).data.learnerId;
        allow delete: if teachesClass(classId);
      }

      // Peer feedback sent to a classmate: the giver writes it, the receiver and the teacher read it
      match /feedback/{fid} {
        allow read: if viewsClass(classId)
          || (memberOf(classId) && (resource.data.fromUid == request.auth.uid
              || resource.data.to == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.learnerId));
        allow create, update: if memberOf(classId) && request.resource.data.fromUid == request.auth.uid;
        allow delete: if teachesClass(classId);
      }

      // Teacher training: comments pinned to moments in a lesson video.
      match /ttnotes/{key}/c/{noteId} {
        allow read: if viewsClass(classId) || memberOf(classId);
        allow create: if (teachesClass(classId) || memberOf(classId)) && request.resource.data.by == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
        allow delete: if teachesClass(classId) || (signedIn() && resource.data.by == request.auth.uid);
      }

      // Shared documents (Collaborate), listed so they can be found and continued
      match /collabs/{docId} {
        allow read: if viewsClass(classId) || memberOf(classId);
        allow write: if teachesClass(classId);
      }

      // Files learners hand in ("File upload" questions): a record and the file in parts.
      // Only the learner who sent it and the class's teachers can open it.
      match /files/{fileId} {
        allow read: if viewsClass(classId) || (signedIn() && resource.data.owner == request.auth.uid);
        allow create: if (memberOf(classId) || teachesClass(classId))
          && request.resource.data.owner == request.auth.uid
          && (!('data' in request.resource.data) || request.resource.data.data.size() < 700000)
          && request.resource.data.get('size', 0) <= 10485760;
        allow delete: if teachesClass(classId) || (signedIn() && resource.data.owner == request.auth.uid);
      }

      // Short audio clips (recorded or uploaded by the teacher)
      match /media/{mediaId} {
        // Sounds and videos (and their scripts) open from a QR code without signing in.
        allow read: if resource.data.get('public', false) == true || viewsClass(classId) || memberOf(classId);
        allow create: if teachesClass(classId) && hasRoom(classData(classId).teacherId) && request.resource.data.size < 700000;
        allow update: if teachesClass(classId) && request.resource.data.get('size', 0) < 700000;
        allow delete: if teachesClass(classId);
      }

      // Profile pictures in use in this class (one person per picture)
      match /avatars/{key} {
        allow read: if viewsClass(classId) || memberOf(classId);
        allow create: if (teachesClass(classId) || memberOf(classId)) && request.resource.data.uid == request.auth.uid;
        allow update: if resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
        allow delete: if resource.data.uid == request.auth.uid || teachesClass(classId);
      }

      // Announcements: the teacher writes; learners can only add their own "Got it"
      match /announcements/{aid} {
        allow read: if viewsClass(classId) || (memberOf(classId) && resource.data.get('sendAt', 0) <= request.time.toMillis());
        allow create, delete: if teachesClass(classId);
        allow update: if teachesClass(classId)
          || (memberOf(classId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acks'])
              && request.resource.data.acks.diff(resource.data.get('acks', {})).affectedKeys().hasOnly([get(/databases/$(database)/documents/users/$(request.auth.uid)).data.learnerId]));
      }

      // Annotations on task text and on long answers
      match /annotations/{aid} {
        allow read: if viewsClass(classId)
          || (memberOf(classId) && (resource.data.visibility == 'class' || resource.data.get('learnerUid', '') == request.auth.uid));
        allow create, delete: if teachesClass(classId);
        // Learners can only add replies to threads they can see.
        allow update: if teachesClass(classId)
          || (memberOf(classId) && (resource.data.visibility == 'class' || resource.data.get('learnerUid', '') == request.auth.uid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies']));
      }

      // Tag notifications
      match /notices/{nid} {
        allow read: if viewsClass(classId)
          || (memberOf(classId) && resource.data.to == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.learnerId);
        allow create: if (teachesClass(classId) || memberOf(classId)) && request.resource.data.fromUid == request.auth.uid;
        allow delete: if teachesClass(classId);
      }

      // Message boards and post-it walls
      match /boards/{boardId}/posts/{postId} {
        allow read: if viewsClass(classId) || memberOf(classId);
        allow create: if (teachesClass(classId) || memberOf(classId))
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
        allow update: if (teachesClass(classId) || memberOf(classId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if teachesClass(classId) || resource.data.byUid == request.auth.uid;
      }

      // Shared "draw a card" piles (played together as a class)
      match /picks/{pickId} {
        allow read: if viewsClass(classId) || memberOf(classId);
        allow write: if teachesClass(classId)
          || (memberOf(classId) && request.resource.data.keys().hasOnly(['taskId', 'pickId', 'h', 'b', 'seq', 'by', 'at']));
      }

      // Where the teacher is in a lesson
      match /live/{docId} {
        allow read: if viewsClass(classId) || memberOf(classId);
        allow write: if teachesClass(classId);
      }

      // Discussion board. Learners see approved, visible threads and posts plus their own;
      // they may post when not muted, and only touch reactions and reports on others' posts.
      function disc() { return classData(classId).get('discussion', {}); }
      function myLearner() { return get(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)).data.learnerId; }
      function discCanPost() { return memberOf(classId) && !(myLearner() in disc().get('muted', [])); }
      function discApproved(d) { return d.approved == (disc().get('approval', false) == false); }
      function ownPost(d) { return d.by == request.auth.uid && d.teacher == false && d.learnerId == myLearner(); }
      match /threads/{tid} {
        allow read: if viewsClass(classId)
          || (memberOf(classId) && ((resource.data.approved == true && resource.data.hidden == false) || resource.data.by == request.auth.uid));
        allow create: if teachesClass(classId)
          || (discCanPost() && disc().get('learnersStart', true) == true && ownPost(request.resource.data) && discApproved(request.resource.data)
              && request.resource.data.pinned == false && request.resource.data.locked == false && request.resource.data.hidden == false);
        allow update: if teachesClass(classId)
          || (memberOf(classId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'reported', 'lastAt', 'replyCount']))
          || (discCanPost() && resource.data.by == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'mentions', 'reactions', 'reported', 'lastAt', 'replyCount']));
        allow delete: if teachesClass(classId) || (signedIn() && resource.data.by == request.auth.uid);

        match /posts/{pid} {
          allow read: if viewsClass(classId)
            || (memberOf(classId) && ((resource.data.approved == true && resource.data.hidden == false) || resource.data.by == request.auth.uid));
          allow create: if teachesClass(classId)
            || (discCanPost() && ownPost(request.resource.data) && discApproved(request.resource.data) && request.resource.data.hidden == false
                && get(/databases/$(database)/documents/classes/$(classId)/threads/$(tid)).data.locked == false);
          allow update: if teachesClass(classId)
            || (memberOf(classId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'reported']))
            || (discCanPost() && resource.data.by == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'edited', 'mentions', 'reactions', 'reported']));
          allow delete: if teachesClass(classId) || (signedIn() && resource.data.by == request.auth.uid);
        }
      }

      // Lesson recaps: the teacher writes them; a learner reads their own once shared
      match /recaps/{recapId} {
        allow read: if viewsClass(classId) || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'shared');
        allow write: if teachesClass(classId);
      }

      // Who is online and which task they are on
      match /presence/{uid} {
        // learners see who else is in the class's live lesson
        allow read: if viewsClass(classId) || memberOf(classId);
        allow write: if isSelf(uid) && memberOf(classId);
        allow delete: if teachesClass(classId);
      }

      // Roster: teacher only
      match /learners/{learnerId} {
        allow read: if viewsClass(classId) || runsClass(classId);
        allow write: if teachesClass(classId) || runsClass(classId);
      }
      match /secrets/{learnerId} {
        allow read: if teachesClass(classId) || runsClass(classId);
        allow write: if teachesClass(classId) || runsClass(classId);
        // A learner who sets their own PIN or password replaces the record with a note that
        // says so; the PIN itself is never written, so the teacher cannot see it.
        allow create, update: if memberOf(classId)
          && get(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)).data.learnerId == learnerId
          && request.resource.data.keys().hasOnly(['own', 'kind', 'at'])
          && request.resource.data.own == true;
      }
      match /members/{memberUid} {
        allow read: if viewsClass(classId) || isSelf(memberUid) || runsClass(classId);
        allow write: if teachesClass(classId) || runsClass(classId);
      }
    }

    // Recaps shared with a parent through a private link: read one at a time, no sign-in needed
    match /recapShares/{token} {
      allow get: if true;
      allow list: if false;
      allow write: if teachesClass(request.resource.data.classId) && (resource == null || resource.data.classId == request.resource.data.classId);
    }

    // Colleague invitation links: anyone signed in as a teacher can open one by its token
    match /colleagueLinks/{token} {
      allow get: if isTeacher();
      allow list: if signedIn() && resource.data.from == request.auth.uid;
      allow create: if isTeacher() && request.resource.data.from == request.auth.uid;
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    // Lessons, tasks, documents and media a teacher shares: a read-only copy, opened by anyone
    // with the link or only by the colleagues it is shared with. The owner can update or stop it.
    function shareOk(d) { return isTeacher() && (d.owner == request.auth.uid || d.mode == 'link' || request.auth.uid in d.get('people', [])); }
    function shareOf(id) { return get(/databases/$(database)/documents/shares/$(id)).data; }
    match /shares/{id} {
      allow get: if shareOk(resource.data);
      allow list: if signedIn() && (resource.data.owner == request.auth.uid || request.auth.uid in resource.data.get('people', []));
      allow create: if isTeacher() && request.resource.data.owner == request.auth.uid;
      allow update: if signedIn() && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
      match /{sub}/{docId} {
        allow read: if shareOk(shareOf(id));
        allow write: if signedIn() && shareOf(id).owner == request.auth.uid;
      }
    }

    // Ready video rooms (made by scripts/video.mjs). Anyone signed in takes a free one for a call;
    // nobody else can make, change or remove them.
    match /callRooms/{id} {
      allow read: if signedIn();
      allow update: if signedIn() && resource.data.state == 'free' && request.resource.data.state == 'used'
        && request.resource.data.by == request.auth.uid
        // a teacher whose organisation has used its call minutes this month starts no new call
        && orgHasRoom(acct(request.auth.uid).get('org', null), 'callMinutes')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'by', 'usedAt', 'for']);
      // The room's host key: only for the teacher who took the room.
      match /host/{k} {
        allow read: if isTeacher() && get(/databases/$(database)/documents/callRooms/$(id)).data.get('by', '') == request.auth.uid;
      }
    }
    // A call's own link (eltsuite.com/call/<code>): anyone with the code opens it, nobody can list
    // them; the person who made it can change or remove it.
    // What people do, for super admins (src/lib/usage.ts): a summary per person and their visits.
    // Each person writes only their own; learners write only that they came; super admins read.
    match /usage/{uid} {
      allow read, delete: if isOwner();
      allow create, update: if isSelf(uid) && request.resource.data.keys().hasOnly(['last', 'visits', 'role', 'at']);
      match /visits/{vid} {
        allow read, delete: if isOwner();
        allow create: if isSelf(uid) && request.resource.data.keys().hasOnly(['start', 'last', 'device', 'role', 'events', 'n'])
          && request.resource.data.events is list && request.resource.data.events.size() <= 1500
          && (!learnerAccount() || (request.resource.data.role == 'learner' && request.resource.data.events.size() <= 1));
        allow update: if isSelf(uid) && !learnerAccount()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['events', 'last', 'n'])
          && request.resource.data.events.size() <= 1600;
      }
    }
    match /callLinks/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
      allow update: if signedIn() && (resource.data.by == request.auth.uid
        // A meeting's guest link: whoever of the meeting starts it points the link at its room.
        || (resource.data.get('sessionId', null) is string
            && request.auth.uid in get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.get('attendees', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['url', 'at'])));
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }
    // A teacher's time zone (IANA name), so the colleagues who have them in their list can see
    // a meeting's time on their clock. Only the teacher writes it; nothing else is kept here.
    match /zones/{uid} {
      allow read: if isSelf(uid) || (isTeacher() && exists(/databases/$(database)/documents/users/$(uid)/colleagues/$(request.auth.uid)));
      allow write: if isSelf(uid) && !learnerAccount() && request.resource.data.keys().hasOnly(['tz', 'at'])
        && request.resource.data.tz is string && request.resource.data.tz.size() < 64;
    }
    // Calling someone into a call (a class's video room): their device rings. Teachers ring;
    // each person reads and clears only their own.
    match /callRings/{key} {
      allow read, delete: if signedIn() && chatKey() == key;
      allow create, update: if isTeacher() && request.resource.data.by == request.auth.uid;
    }
    // Attendance for calls: who was in a call and when (and, unless the organisation turns it
    // off, their microphone and camera). Written by one person in the call; read only by the
    // teachers it belongs to (readers), never by learners.
    function logReaders(d) {
      return d.kind == 'class' ? d.readers.toSet().difference([classData(d.classId).teacherId].toSet().union(classData(d.classId).get('coTeachers', {}).keys().toSet())).size() == 0
        : d.kind == 'chat' ? d.readers.hasOnly(chatOf(d.chatId).members)
        : d.kind == 'meeting' ? d.readers.toSet().difference([get(/databases/$(database)/documents/sessions/$(d.sessionId)).data.owner].toSet().union(get(/databases/$(database)/documents/sessions/$(d.sessionId)).data.get('attendees', []).toSet())).size() == 0
        : d.readers.hasOnly([get(/databases/$(database)/documents/callLinks/$(d.code)).data.by]);
    }
    function logWriter(d) {
      return signedIn() && chatKey() in d.people && d.recorder == chatKey()
        && (d.kind != 'class' || viewsClass(d.classId))
        && (d.kind != 'chat' || chatKey() in chatOf(d.chatId).members)
        && (d.kind == 'chat' || isTeacher())
        && logReaders(d);
    }
    match /callLogs/{id} {
      allow read: if isTeacher() && request.auth.uid in resource.data.get('readers', []);
      allow create: if logWriter(request.resource.data);
      allow update: if logWriter(request.resource.data) && request.resource.data.kind == resource.data.kind
        && request.resource.data.get('classId', null) == resource.data.get('classId', null)
        && request.resource.data.get('chatId', null) == resource.data.get('chatId', null);
    }
    // The timetable: classes, meetings and one-to-ones. A class's sessions are seen by its
    // teachers and learners; a meeting by the people invited.
    function sessionReader(d) {
      return signedIn() && (d.owner == request.auth.uid || request.auth.uid in d.get('attendees', [])
        || (d.get('classId', null) is string && (viewsClass(d.classId) || (learnerAccount() && myClass() == d.classId))));
    }
    // gcal holds each teacher's Google Calendar event for the session: everyone sets only their own.
    function gcalOwnOnly() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['gcal'])
        || request.resource.data.get('gcal', {}).diff(resource.data.get('gcal', {})).affectedKeys().hasOnly([request.auth.uid]);
    }
    match /sessions/{id} {
      allow read: if sessionReader(resource.data);
      allow create: if isTeacher() && request.resource.data.owner == request.auth.uid
        && (request.resource.data.get('classId', null) == null || teachesClass(request.resource.data.classId))
        && request.resource.data.get('gcal', {}).keys().hasOnly([request.auth.uid]);
      allow update: if signedIn() && gcalOwnOnly() && (resource.data.owner == request.auth.uid
        || (resource.data.get('classId', null) is string && teachesClass(resource.data.classId))
        || (request.auth.uid in resource.data.get('attendees', []) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['live', 'gcal']))
        || (isTeacher() && sessionReader(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gcal'])));
      allow delete: if signedIn() && (resource.data.owner == request.auth.uid || (resource.data.get('classId', null) is string && teachesClass(resource.data.classId)));
    }

    // Messages. A person's key is a teacher's sign-in id or a learner's learner id. Only the
    // people in a chat can read it: messages are private, teachers included.
    function chatKey() {
      return learnerAccount() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.learnerId : request.auth.uid;
    }
    function myClass() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classId; }
    function chatOf(id) { return get(/databases/$(database)/documents/chats/$(id)).data; }
    function inChat(c) { return signedIn() && chatKey() in c.members; }
    // The class decides: no messages; only with teachers (or groups the teacher makes); or freely.
    function msgMode() { return classData(myClass()).get('messaging', {}).get('mode', 'free'); }
    function learnerMayStart(c) { return msgMode() == 'free' || (msgMode() != 'off' && c.roles.values().removeAll(['teacher']).size() <= 1); }
    // Collaborative documents in a teacher's files, shared person by person.
    // Namespace revision locks serialize names across file kinds and browser sessions.
    match /fileNamespaces/{key} {
      function permitted(d) {
        return isTeacher() && (d.owner == request.auth.uid
          || (d.folder != '' && exists(/databases/$(database)/documents/sharedFolders/$(d.folder))
            && get(/databases/$(database)/documents/sharedFolders/$(d.folder)).data.owner == d.owner
            && get(/databases/$(database)/documents/sharedFolders/$(d.folder)).data.get('members', {}).get(request.auth.uid, {}).get('role', '') == 'edit'));
      }
      allow read: if isTeacher() && (resource == null || permitted(resource.data));
      allow create: if permitted(request.resource.data) && request.resource.data.keys().hasOnly(['owner', 'folder', 'path', 'version'])
        && request.resource.data.owner is string && request.resource.data.folder is string && request.resource.data.path is string && request.resource.data.version == 1;
      allow update: if permitted(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['version'])
        && request.resource.data.version == resource.data.version + 1;
    }
    match /sharedDocs/{id} {
      allow read: if signedIn() && (resource.data.owner == request.auth.uid || request.auth.uid in resource.data.memberIds);
      // In a shared folder, files belong to the folder's owner, whoever makes them.
      allow create: if isTeacher() && hasRoom(request.resource.data.owner) && (request.resource.data.owner == request.auth.uid
        || (request.resource.data.folder is string && get(/databases/$(database)/documents/sharedFolders/$(request.resource.data.folder)).data.owner == request.resource.data.owner
          && get(/databases/$(database)/documents/sharedFolders/$(request.resource.data.folder)).data.members[request.auth.uid].role == 'edit'
          && request.resource.data.createdBy == request.auth.uid));
      allow update: if signedIn() && !('purgeRequestedAt' in resource.data) && !('purgingAt' in resource.data)
        && !('purgingAt' in request.resource.data)
        && (!('purgeRequestedAt' in request.resource.data) || resource.data.get('deletedAt', 0) > 0)
        && (resource.data.owner == request.auth.uid
        || (resource.data.get('deletedAt', 0) == 0 && resource.data.members[request.auth.uid].role == 'edit' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'updatedAt', 'flash', 'pd', 'size', 'citeStyle', 'ltype', 'designType']))
        // in an organisation's shared drive, its admins decide who has the files
        || (resource.data.get('folder', null) is string && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds'])
            && get(/databases/$(database)/documents/sharedFolders/$(resource.data.folder)).data.get('org', null) is string
            && adminOfOrg(get(/databases/$(database)/documents/sharedFolders/$(resource.data.folder)).data.org)));
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
      // Flashcards and reading notes inside a file: everyone it is shared with reads; editors write.
      function fileData() { return get(/databases/$(database)/documents/sharedDocs/$(id)).data; }
      // Comments on a file: everyone it is shared with reads; commenters and editors write their own.
      match /comments/{cid} {
        allow read: if signedIn() && (fileData().owner == request.auth.uid || request.auth.uid in fileData().memberIds);
        allow create: if signedIn() && request.resource.data.by == request.auth.uid
          && (fileData().owner == request.auth.uid || fileData().members[request.auth.uid].role in ['edit', 'comment', 'suggest']);
        allow update: if signedIn() && (fileData().owner == request.auth.uid || fileData().members[request.auth.uid].role == 'edit')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done']);
        allow delete: if signedIn() && (resource.data.by == request.auth.uid || fileData().owner == request.auth.uid);
      }
      match /{part}/{rowId} {
        allow read: if signedIn() && (fileData().owner == request.auth.uid || request.auth.uid in fileData().memberIds);
        allow write: if signedIn() && (fileData().owner == request.auth.uid || fileData().members[request.auth.uid].role == 'edit');
      }
    }
    match /sharedFolders/{id} {
      allow read: if signedIn() && (resource.data.owner == request.auth.uid || request.auth.uid in resource.data.memberIds || (resource.data.get('org', null) is string && adminOfOrg(resource.data.org)));
      allow create: if isTeacher() && request.resource.data.owner == request.auth.uid;
      // an organisation's drive folders: any of its admins keeps them
      allow update, delete: if signedIn() && (resource.data.owner == request.auth.uid || (resource.data.get('org', null) is string && adminOfOrg(resource.data.org)));
    }
    // Recordings of the sounds of English. The default set, for everyone, is kept by the app's
    // owner; each teacher can add their own, which learners hear in that teacher's tasks.
    match /voicePreviews/{voice} {
      allow read: if signedIn();
      allow create, update: if isOwner()
        && voice in ['marin', 'cedar', 'coral', 'ash', 'sage', 'verse', 'alloy', 'ballad', 'echo', 'shimmer']
        && request.resource.data.keys().hasOnly(['data', 'name', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000
        && request.resource.data.data.matches('data:audio/mpeg;base64,.*')
        && request.resource.data.get('lessonStyle', 'adult') in ['adult', 'young']
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 150
        && request.resource.data.updatedAt is number;
    }
    match /phonemeAudio/{key} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.token.email == 'ardanurioglu@gmail.com';
    }
    // Sound effects for the sound editor: the owner's set for everyone, and each teacher's own.
    match /sfxAudio/{key} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.token.email == 'ardanurioglu@gmail.com';
    }
    match /teacherSfx/{id} {
      allow read: if signedIn() && (resource.data.by == request.auth.uid || resource.data.get('everyone', false) == true);
      allow create: if isTeacher() && request.resource.data.by == request.auth.uid && request.resource.data.data is string && request.resource.data.data.size() < 900000 && (request.resource.data.get('everyone', false) == false || isOwner());
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }
    match /teacherSounds/{key} {
      allow read: if signedIn();
      allow create, update: if isTeacher() && key.matches(request.auth.uid + '_.*') && request.resource.data.by == request.auth.uid && request.resource.data.data is string && request.resource.data.data.size() < 900000;
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }
    // Emails waiting to go out (scripts/mail.mjs sends them). Teachers add; only the mail job reads.
    match /outbox/{id} {
      allow create: if isTeacher() && teachesClass(request.resource.data.classId) && request.resource.data.state == 'waiting';
    }
    // Profile photos: small pictures anyone signed in may see; only the owner changes theirs.
    // Accounts: the plan, space, pause and apps of each teacher. The owner sets them.
    match /accounts/{uid} {
      // an organisation's admins see its teachers' space, for their overview
      allow read: if isSelf(uid) || isOwner() || (resource.data.get('org', null) is string && adminOfOrg(resource.data.org));
      allow write: if isOwner();
      // A teacher saying yes to an organisation's invitation sets their own organisation.
      allow create: if isSelf(uid) && request.resource.data.keys().hasOnly(['org', 'invite']) && invitedTo(request.resource.data.invite, request.resource.data.org);
      // A new teacher making their account with an organisation's invitation code.
      allow create: if isSelf(uid) && request.resource.data.keys().hasOnly(['org', 'code']) && codeForOrg(request.resource.data.code, request.resource.data.org);
      allow update: if isSelf(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['org', 'invite']) && invitedTo(request.resource.data.invite, request.resource.data.org);
    }
    // An invitation for this teacher's email to this organisation, not yet answered.
    function invitedTo(inviteId, orgId) {
      return signedIn() && inviteId is string && orgId is string
        && exists(/databases/$(database)/documents/orgInvites/$(inviteId))
        && get(/databases/$(database)/documents/orgInvites/$(inviteId)).data.org == orgId
        && get(/databases/$(database)/documents/orgInvites/$(inviteId)).data.email == request.auth.token.get('email', '').lower()
        && get(/databases/$(database)/documents/orgInvites/$(inviteId)).data.status == 'pending';
    }
    // An organisation's invitation for this email, not yet answered (by its id).
    function invitedHere(inviteId) {
      return signedIn() && inviteId is string
        && exists(/databases/$(database)/documents/orgInvites/$(inviteId))
        && get(/databases/$(database)/documents/orgInvites/$(inviteId)).data.email == request.auth.token.get('email', '').lower()
        && get(/databases/$(database)/documents/orgInvites/$(inviteId)).data.status == 'pending';
    }
    // Invitation codes (inviteCodes/{code}): made by a super admin, or by an organisation's admins for
    // their organisation. A new teacher types one in to make their account. A code can be used a set
    // number of times, until a date, and only by one email if it names one.
    function codeData(c) { return get(/databases/$(database)/documents/inviteCodes/$(c)).data; }
    function codeOpen(c) {
      return signedIn() && c is string && exists(/databases/$(database)/documents/inviteCodes/$(c))
        && codeData(c).get('off', false) != true
        && codeData(c).get('uses', 0) < codeData(c).get('maxUses', 1)
        && (codeData(c).get('expires', 0) == 0 || codeData(c).get('expires', 0) > request.time.toMillis())
        && (codeData(c).get('email', '') == '' || codeData(c).get('email', '') == request.auth.token.get('email', '').lower());
    }
    // The code is open and this same write takes one of its uses, for this account.
    function codeUsedNow(c) {
      return codeOpen(c)
        && getAfter(/databases/$(database)/documents/inviteCodes/$(c)).data.get('uses', 0) == codeData(c).get('uses', 0) + 1
        && request.auth.uid in getAfter(/databases/$(database)/documents/inviteCodes/$(c)).data.get('usedBy', {});
    }
    function codeForOrg(c, orgId) { return codeOpen(c) && codeData(c).get('org', '') == orgId; }
    match /inviteCodes/{code} {
      // The code is the secret: anyone who has it can look it up, before they have an account.
      allow get: if true;
      allow list: if isOwner() || adminOfOrg(resource.data.org);
      allow create: if (isOwner() || (adminOfOrg(request.resource.data.get('org', null)) && orgHasRoom(request.resource.data.org, 'teachers')))
        && request.resource.data.by == request.auth.uid
        && request.resource.data.get('uses', 0) == 0 && request.resource.data.get('usedBy', {}).size() == 0
        && request.resource.data.maxUses is int && request.resource.data.maxUses >= 1 && request.resource.data.maxUses <= 500
        && code.size() >= 8 && code.size() <= 24;
      // Its makers turn it off, change how many uses or the date, or delete it; an organisation's admins, only theirs.
      allow update: if (isOwner() || (adminOfOrg(resource.data.get('org', null)) && request.resource.data.get('org', null) == resource.data.get('org', null)))
        && request.resource.data.get('uses', 0) == resource.data.get('uses', 0);
      allow delete: if isOwner() || adminOfOrg(resource.data.get('org', null));
      // A new teacher using it: one more use, by them, with the account made in the same write.
      allow update: if signedIn() && !learnerAccount() && codeOpen(code)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses', 'usedBy'])
        && request.resource.data.uses == resource.data.get('uses', 0) + 1
        && request.resource.data.usedBy.diff(resource.data.get('usedBy', {})).affectedKeys().hasOnly([request.auth.uid])
        && !(request.auth.uid in resource.data.get('usedBy', {}))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('code', '') == code;
    }
    // An organisation's limits (orgs/{id}.limits, set by a super admin) and what it uses
    // (orgs/{id}.usage: counted every 15 minutes by scripts/space.mjs, and counted up at once by the
    // app as classes and learners are added). A limit that is not set means no limit.
    function orgDoc(orgId) { return get(/databases/$(database)/documents/orgs/$(orgId)).data; }
    function limitOf(orgId, k) { return orgDoc(orgId).get('limits', {}).get(k, -1); }
    function usedOf(orgId, k) { return orgDoc(orgId).get('usage', {}).get(k, 0); }
    function orgHasRoom(orgId, k) {
      return !(orgId is string) || !exists(/databases/$(database)/documents/orgs/$(orgId))
        || limitOf(orgId, k) < 0
        || (k == 'teachers' ? orgDoc(orgId).get('teachers', {}).size() : usedOf(orgId, k)) < limitOf(orgId, k);
    }
    // A class or learner added to a limited organisation: the same write counts it, within the limit.
    function countedIn(orgId, k) {
      return !(orgId is string) || !exists(/databases/$(database)/documents/orgs/$(orgId))
        || limitOf(orgId, k) < 0
        || (getAfter(/databases/$(database)/documents/orgs/$(orgId)).data.get('usage', {}).get(k, 0) == usedOf(orgId, k) + 1
            && usedOf(orgId, k) + 1 <= limitOf(orgId, k));
    }
    function adminOfOrg(orgId) {
      return signedIn() && orgId is string && exists(/databases/$(database)/documents/orgs/$(orgId))
        && request.auth.token.get('email', '').lower() in get(/databases/$(database)/documents/orgs/$(orgId)).data.adminEmails;
    }
    // Invitations to join an organisation. The link carries the id, so anyone with it can read it.
    match /orgInvites/{id} {
      allow get: if true;
      allow list: if isOwner() || adminOfOrg(resource.data.org);
      allow create: if (isOwner() || (adminOfOrg(request.resource.data.org) && request.resource.data.get('admin', false) == false)) && request.resource.data.status == 'pending' && request.resource.data.email is string && request.resource.data.by == request.auth.uid;
      allow update: if isOwner() || adminOfOrg(resource.data.org)
        || (signedIn() && resource.data.status == 'pending' && resource.data.email == request.auth.token.get('email', '').lower()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'uid', 'answeredAt'])
            && request.resource.data.status in ['accepted', 'declined'] && request.resource.data.uid == request.auth.uid);
      allow delete: if isOwner() || adminOfOrg(resource.data.org);
    }
    // Organisations and their admins (by email). The owner makes them; admins see theirs.
    match /orgs/{id} {
      function orgAdmin() { return signedIn() && request.auth.token.get('email', '').lower() in resource.data.adminEmails; }
      allow read: if isOwner() || orgAdmin() || (signedIn() && request.auth.uid in resource.data.get('teachers', {}));
      allow create, delete: if isOwner();
      // Admins choose the branding and who their teachers may work with.
      allow update: if isOwner() || (orgAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['brand', 'outside', 'policy', 'teachers', 'perTeacherGb', 'drives', 'tags', 'libraryName', 'ttForms']) && request.resource.data.teachers.keys().hasOnly(resource.data.teachers.keys()));
      // A teacher saying yes to an invitation, or making their account with the organisation's
      // invitation code, adds themselves, and only themselves, within its limit of teachers.
      allow update: if signedIn() && !(request.auth.uid in resource.data.get('teachers', {}))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teachers', 'adminEmails'])
        && request.resource.data.teachers.diff(resource.data.get('teachers', {})).affectedKeys().hasOnly([request.auth.uid])
        && (resource.data.get('limits', {}).get('teachers', -1) < 0 || request.resource.data.teachers.size() <= resource.data.get('limits', {}).get('teachers', -1))
        && (
          (codeForOrg(request.resource.data.teachers[request.auth.uid].get('code', null), id)
            && request.resource.data.get('adminEmails', []) == resource.data.get('adminEmails', []))
          || (invitedTo(request.resource.data.teachers[request.auth.uid].get('invite', null), id)
            // invited as an admin: they add their own email to the admins, and nothing else
            && (request.resource.data.get('adminEmails', []) == resource.data.get('adminEmails', [])
                || (get(/databases/$(database)/documents/orgInvites/$(request.resource.data.teachers[request.auth.uid].invite)).data.get('admin', false) == true
                    && request.resource.data.adminEmails == resource.data.get('adminEmails', []).concat([request.auth.token.get('email', '').lower()]))))
        );
      // Counting a class or learner as it is added (see countedIn): its teachers and admins add one
      // at a time, within the limit. scripts/space.mjs recounts every 15 minutes.
      allow update: if signedIn() && (request.auth.uid in resource.data.get('teachers', {}) || request.auth.token.get('email', '').lower() in resource.data.get('adminEmails', []))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usage'])
        && request.resource.data.usage.diff(resource.data.get('usage', {})).affectedKeys().size() == 1
        && (
          (request.resource.data.usage.diff(resource.data.get('usage', {})).affectedKeys().hasOnly(['classes'])
            && request.resource.data.usage.classes == resource.data.get('usage', {}).get('classes', 0) + 1
            && (resource.data.get('limits', {}).get('classes', -1) < 0 || request.resource.data.usage.classes <= resource.data.get('limits', {}).get('classes', -1)))
          || (request.resource.data.usage.diff(resource.data.get('usage', {})).affectedKeys().hasOnly(['learners'])
            && request.resource.data.usage.learners == resource.data.get('usage', {}).get('learners', 0) + 1
            && (resource.data.get('limits', {}).get('learners', -1) < 0 || request.resource.data.usage.learners <= resource.data.get('limits', {}).get('learners', -1)))
        );
      // What its admins changed (see logOrg in lib/admin.ts): the owner and the organisation's
      // admins read it and add to it, each entry signed with their own uid. Nobody edits or deletes one.
      match /log/{entry} {
        allow read: if isOwner() || adminOfOrg(id);
        allow create: if (isOwner() || adminOfOrg(id))
          && request.resource.data.keys().hasOnly(['by', 'byName', 'at', 'what', 'detail'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at is number
          && request.resource.data.what is string && request.resource.data.what.size() <= 200
          && request.resource.data.get('detail', '') is string && request.resource.data.get('detail', '').size() <= 400
          && request.resource.data.get('byName', '') is string && request.resource.data.get('byName', '').size() <= 80;
      }
    }
    // Super admins, by email: each one can see the list and add or remove others. The owner is
    // always a super admin and is never in this list.
    match /superAdmins/{email} {
      allow get: if signedIn() && (isOwner() || email == request.auth.token.get('email', '').lower());
      allow list: if isOwner();
      allow create: if isOwner() && email == email.lower() && email != 'ardanurioglu@gmail.com'
        && request.resource.data.keys().hasOnly(['name', 'by', 'byName', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 80;
      allow delete: if isOwner();
    }
    // Each time a super admin signed in as someone (functions/index.js writes it): super admins read it.
    match /proxyLog/{id} {
      allow read: if isOwner();
    }
    // Support tickets and conversations with Claude were removed: their old documents
    // (tickets, claudeThreads) are kept but nobody can read or change them.
    // A teacher's profile for the colleagues in their organisation.
    match /teacherProfiles/{uid} {
      allow read: if isSelf(uid) || isOwner() || (signedIn() && resource.data.org is string && request.auth.uid in get(/databases/$(database)/documents/orgs/$(resource.data.org)).data.get('teachers', {}));
      allow write: if isSelf(uid);
    }
    // Switches for the whole app.
    match /admin/{key} {
      allow read: if signedIn();
      allow write: if isOwner();
    }
    // Profile pictures everyone signed in can see, by chat id (see lib/faces.ts).
    match /faces/{key} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid && request.resource.data.avatar is string && request.resource.data.avatar.size() < 200;
      allow update: if signedIn() && resource.data.by == request.auth.uid && request.resource.data.by == request.auth.uid && request.resource.data.avatar.size() < 200;
    }
    match /photos/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && request.resource.data.data.size() < 120000;
    }
    // Recording together (see lib/studio.ts): the host and the colleagues they invite.
    function studioOf(id) { return get(/databases/$(database)/documents/studios/$(id)).data; }
    match /studios/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if isTeacher() && request.resource.data.host == request.auth.uid && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.host == resource.data.host && request.resource.data.members == resource.data.members;
      allow delete: if signedIn() && resource.data.host == request.auth.uid;
      match /peers/{uid} {
        allow read: if signedIn() && request.auth.uid in studioOf(id).members;
        allow write: if signedIn() && uid == request.auth.uid && request.auth.uid in studioOf(id).members;
      }
      match /signal/{pairId} {
        allow read, write: if signedIn() && request.auth.uid in studioOf(id).members && pairId.matches('.*' + request.auth.uid + '.*');
        match /{rest=**} {
          allow read, write: if signedIn() && request.auth.uid in studioOf(id).members && pairId.matches('.*' + request.auth.uid + '.*');
        }
      }
      match /takes/{takeId} {
        allow read: if signedIn() && request.auth.uid in studioOf(id).members;
        allow write: if signedIn() && request.auth.uid in studioOf(id).members && takeId.matches('.*_' + request.auth.uid);
        allow delete: if signedIn() && studioOf(id).host == request.auth.uid;
        match /parts/{k} {
          allow read: if signedIn() && request.auth.uid in studioOf(id).members;
          allow write: if signedIn() && request.auth.uid in studioOf(id).members && takeId.matches('.*_' + request.auth.uid);
          allow delete: if signedIn() && studioOf(id).host == request.auth.uid;
        }
      }
    }
    match /chats/{id} {
      allow read: if inChat(resource.data);
      allow create: if inChat(request.resource.data) && request.resource.data.members.size() <= 60
        && (isTeacher() || (learnerAccount() && request.resource.data.classId == myClass() && learnerMayStart(request.resource.data)));
      allow update: if inChat(resource.data)
        && (isTeacher() || request.resource.data.get('classId', null) == resource.data.get('classId', null));
      allow delete: if signedIn() && resource.data.createdBy == chatKey();
      match /msgs/{mid} {
        allow read: if inChat(chatOf(id));
        allow create: if inChat(chatOf(id)) && request.resource.data.by == chatKey()
          && (!learnerAccount() || msgMode() != 'off')
          && (!learnerAccount() || request.resource.data.get('blocks', 0) == 0
            || classData(myClass()).get('messaging', {}).get('learnerElements', true) == true);
        allow update: if inChat(chatOf(id)) && (resource.data.by == chatKey() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']));
        allow delete: if signedIn() && resource.data.by == chatKey();
        // Answers to the questions in a message. The sender sees them all as they come in;
        // the others see their own, and everyone's once they have answered, when the sender allows it.
        match /answers/{who} {
          allow read: if inChat(chatOf(id)) && (who == chatKey()
            || get(/databases/$(database)/documents/chats/$(id)/msgs/$(mid)).data.by == chatKey()
            || (get(/databases/$(database)/documents/chats/$(id)/msgs/$(mid)).data.get('shareAnswers', false) == true
              && exists(/databases/$(database)/documents/chats/$(id)/msgs/$(mid)/answers/$(chatKey()))));
          allow create, update: if who == chatKey() && inChat(chatOf(id)) && request.resource.data.by == chatKey();
          allow delete: if who == chatKey();
        }
      }
      match /media/{mediaId} {
        allow read: if inChat(chatOf(id));
        allow write: if inChat(chatOf(id));
      }
    }

    function aiAdmin() {
      return isOwner() && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('proxyBy', null) == null;
    }
    // Explicit grants only, including for the owner. No client spending writes.
    match /aiPilot/{uid} {
      allow get: if isSelf(uid) || isOwner();
      allow list: if isOwner();
      allow create, update: if aiAdmin()
        && request.resource.data.keys().hasOnly(['enabled', 'updatedBy', 'updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'teacher';
    }
    match /aiBudgets/{month} { allow read: if isOwner(); }
    // Only the verified-super-admin callable may change limits. No client can reset usage.
    match /aiAllowances/{uid} { allow read: if aiAdmin(); }
    match /aiFeatureUsage/{uid}/days/{day} { allow read: if aiAdmin(); }
    match /aiAdminBudgets/{month} { allow read: if aiAdmin(); }
    match /helpAdminBudgets/{month} { allow read: if aiAdmin(); }

    // Devices that get notifications: each person adds and removes their own.
    match /pushTokens/{t} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.key == chatKey();
    }

    // Class codes: looked up one at a time when learners join
    match /classCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if (isTeacher() && request.resource.data.teacherId == request.auth.uid) || orgAdminFor(request.resource.data.get('org', null), request.resource.data.teacherId);
      allow update: if signedIn() && (resource.data.teacherId == request.auth.uid || teachesClass(resource.data.classId) || runsClass(resource.data.classId))
        && request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if signedIn() && resource.data.teacherId == request.auth.uid;
    }
  }
}
